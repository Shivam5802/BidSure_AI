# ============================================================
# BidSure AI — Backend Environment Configuration (.env.example)
# ============================================================
# Copy this file to .env and configure with your environment values.
# IMPORTANT: Never commit .env or actual secret credentials to git!
# ============================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Server Networking
PORT=5000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL with Prisma)
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bidguard?schema=public"
# Hosted / Managed PostgreSQL example (Render / Neon / Supabase):
# DATABASE_URL="postgresql://user:password@hostname:5432/bidguard?sslmode=require"

# Redis Cache / Background Queue (Optional)
REDIS_URL=redis://localhost:6379

# S3 / MinIO Compatible Object Storage (Optional - fallback to local filesystem if unset)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bidguard-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-minimum-16-characters-long
# Set to true to enforce strict JWT authentication; false allows demo officer fallback
AUTH_ENFORCED=true

# Auth Rate Limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# File Upload Constraints
MAX_TENDER_FILE_SIZE_MB=50

# AI / LLM Verification Engine (gemini | openai | mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=

# Super Administrator Level-0 Primary Credentials (Used for initial bootstrapping)
SUPER_ADMIN_EMAIL=superadmin@gem.gov.in
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!ChangeMe
