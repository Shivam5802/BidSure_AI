# ============================================================
# BidSure AI — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ============================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Server
PORT=5000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bidguard?schema=public"

# Authentication
JWT_SECRET=change-me-in-production

# Set to true to enforce auth on all protected endpoints (false allows demo fallback)
AUTH_ENFORCED=false

# Login rate limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# File upload limit (MB)
MAX_TENDER_FILE_SIZE_MB=50

# Redis (optional — for background job queuing)
REDIS_URL=redis://localhost:6379

# S3-Compatible Object Storage (optional — leave blank to use local filesystem)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bidguard-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# AI / LLM Provider (gemini | openai | mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
